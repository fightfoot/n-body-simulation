import numpy as np
import copy

class Particle:
    G = 6.67408e-11

    def __init__(self, data_lines):

        if len(data_lines) != 5:
            raise ValueError("Incorrect number of lines for particle data.")

        # extracts the data from the text file
        self.position = np.array([float(val) for val in data_lines[0].split()])
        self.velocity = np.array([float(val) for val in data_lines[1].split()])
        self.acceleration = np.array([float(val) for val in data_lines[2].split()])
        self.mass = float(data_lines[3])
        self.name = data_lines[4].strip()
        self.momentum = np.linalg.norm(self.velocity)*self.mass
# implomentation of eulers algorithem
    def eulerupdate(self, deltaT):
        self.position = self.position + self.velocity * deltaT
        self.velocity = self.velocity + self.acceleration * deltaT
# calculation for grav acc using newtons law of grav acc
    def updateGravitationalAcceleration(self, bodies):
        total_gravitational_acceleration = np.zeros(3, dtype=float)

        for body in bodies:
            if isinstance(body, Particle) and body != self:
                r = body.position - self.position
                distance = (np.sqrt((body.position[0] - self.position[0])**2 +
                      (body.position[1] - self.position[1])**2 +
                      (body.position[-1] - self.position[-1])**2))
                direction = r / distance
                gravitational_acceleration = (self.G * body.mass / distance**2) * direction
                total_gravitational_acceleration += gravitational_acceleration

        self.acceleration = total_gravitational_acceleration
#implomentation of Runge-Kutta algorithem
    def rk4update(self, deltaT):
        k1 = self.acceleration * deltaT
        k2 = (self.acceleration + 0.5 * k1) * deltaT
        k3 = (self.acceleration + 0.5 * k2) * deltaT
        k4 = (self.acceleration + k3) * deltaT

        self.position += (self.velocity + (k1 + 2*k2 + 2*k3 + k4)/6) * deltaT
        self.velocity += (k1 + 2*k2 + 2*k3 + k4)/6
#grav energy for conservation checks
    def gpe(particles, bodies):
        total_gpe = 0

        for particle in particles:
            for body in bodies:
                if isinstance(body, Particle) and body != particle:
                    r = np.linalg.norm(body.position - particle.position)
                    gpe = -Particle.G * body.mass * particle.mass / r
                    total_gpe += gpe

        return total_gpe
 
    def __str__(self):
        return "Particle: {0}, Mass: {1:.3e}, Position: {2}, Velocity: {3}, Acceleration: {4}".format(
            self.name, self.mass, self.position, self.velocity, self.acceleration
        )


    


       

     
